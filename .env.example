# ---------------------------------------------------------------------------
# Sanity CMS (optional)
#
# The site runs without these — it falls back to the typed seed content in
# src/content/fallback. Fill these in to manage content through the Studio
# at /studio instead.
#
# Create a project at https://sanity.io and run `npx sanity@latest init`.
# ---------------------------------------------------------------------------

# Required to enable the CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=kbucue55
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Only needed if the dataset is private (access mode "private")
# Create at https://www.sanity.io/manage/project/kbucue55/api/tokens
SANITY_API_READ_TOKEN=

# Used for canonical URLs, Open Graph, and JSON-LD. Defaults to the domain in
# the site settings when unset.
NEXT_PUBLIC_SITE_URL=https://fajarariandi.com

# ---------------------------------------------------------------------------
# Contact form (src/app/api/contact/route.ts)
#
# Optional. Without these, submissions are logged to the server console so the
# form still works end-to-end in development. Uses Resend when configured.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_TO_EMAIL=fajarariandi699@gmail.com
CONTACT_FROM_EMAIL=portfolio@fajarariandi.com
